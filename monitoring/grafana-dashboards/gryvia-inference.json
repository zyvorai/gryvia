{
  "dashboard": {
    "uid": "gryvia-inference",
    "title": "Gryvia - Inference Monitoring",
    "tags": ["gryvia", "inference", "serving"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "DS_PROMETHEUS",
          "type": "datasource",
          "query": "prometheus"
        },
        {
          "name": "service",
          "type": "query",
          "datasource": "${DS_PROMETHEUS}",
          "query": "label_values(gryvia_inference_latency_seconds_bucket, service)",
          "refresh": 2,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "panels": [
      {
        "title": "Inference Latency Breakdown",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "avg(gryvia_inference_stage_latency_seconds{service=~\"$service\", stage=\"dns\"})",
            "legendFormat": "DNS"
          },
          {
            "expr": "avg(gryvia_inference_stage_latency_seconds{service=~\"$service\", stage=\"tcp\"})",
            "legendFormat": "TCP Connect"
          },
          {
            "expr": "avg(gryvia_inference_stage_latency_seconds{service=~\"$service\", stage=\"tls\"})",
            "legendFormat": "TLS Handshake"
          },
          {
            "expr": "avg(gryvia_inference_stage_latency_seconds{service=~\"$service\", stage=\"gpu_queue\"})",
            "legendFormat": "GPU Queue"
          },
          {
            "expr": "avg(gryvia_inference_stage_latency_seconds{service=~\"$service\", stage=\"gpu_exec\"})",
            "legendFormat": "GPU Execution"
          },
          {
            "expr": "avg(gryvia_inference_stage_latency_seconds{service=~\"$service\", stage=\"postprocess\"})",
            "legendFormat": "Post-processing"
          }
        ],
        "yaxes": [
          {"format": "s", "min": 0, "label": "Latency"},
          {"format": "short"}
        ],
        "lines": false,
        "bars": true,
        "fill": 1,
        "stack": true,
        "seriesOverrides": [
          {"alias": "DNS", "color": "#C4162A"},
          {"alias": "TCP Connect", "color": "#FF9830"},
          {"alias": "TLS Handshake", "color": "#FADE2A"},
          {"alias": "GPU Queue", "color": "#73BF69"},
          {"alias": "GPU Execution", "color": "#5794F2"},
          {"alias": "Post-processing", "color": "#B877D9"}
        ]
      },
      {
        "title": "Request Throughput",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(rate(gryvia_inference_requests_total{service=~\"$service\"}[5m])) by (service)",
            "legendFormat": "{{service}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "min": 0, "label": "Requests/s"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "title": "Active Replicas per Service",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "gryvia_inference_active_replicas{service=~\"$service\"}",
            "legendFormat": "{{service}}"
          }
        ],
        "yaxes": [
          {"format": "short", "min": 0, "label": "Replicas"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "steppedLine": true
      },
      {
        "title": "Canary Traffic Split",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(rate(gryvia_inference_requests_total{service=~\"$service\", version=\"canary\"}[5m])) / sum(rate(gryvia_inference_requests_total{service=~\"$service\"}[5m])) * 100",
            "legendFormat": "Canary Traffic %"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 25, "color": "yellow"},
                {"value": 50, "color": "orange"}
              ]
            }
          }
        }
      },
      {
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(rate(gryvia_inference_requests_total{service=~\"$service\", status=\"error\"}[5m])) / sum(rate(gryvia_inference_requests_total{service=~\"$service\"}[5m])) * 100",
            "legendFormat": "Error Rate %"
          }
        ],
        "yaxes": [
          {"format": "percent", "min": 0, "max": 100, "label": "Error %"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "thresholds": [
          {"value": 1, "colorMode": "warning", "fill": false, "line": true, "op": "gt"},
          {"value": 5, "colorMode": "critical", "fill": false, "line": true, "op": "gt"}
        ]
      }
    ]
  }
}
