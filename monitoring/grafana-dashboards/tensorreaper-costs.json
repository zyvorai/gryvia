{
  "dashboard": {
    "title": "TensorReaper - Cost Analysis",
    "tags": ["tensorreaper", "costs", "budgets", "chargeback"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "5m",
    "panels": [
      {
        "title": "Total Monthly Spending",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(tensorreaper_budget_spent_month)",
            "legendFormat": "Total Spent"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "title": "Total Budget Remaining",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "sum(tensorreaper_budget_remaining)",
            "legendFormat": "Remaining"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 5000, "color": "yellow"},
                {"value": 10000, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "title": "Budget Utilization Rate",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "avg(tensorreaper_budget_percent_used)",
            "legendFormat": "Avg % Used"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 75, "color": "yellow"},
                {"value": 90, "color": "orange"},
                {"value": 100, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "title": "Projected Month-End Overspend",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(tensorreaper_budget_projected_spend) - sum(tensorreaper_budget_monthly_limit)",
            "legendFormat": "Overspend"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": -10000, "color": "green"},
                {"value": 0, "color": "yellow"},
                {"value": 5000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "title": "Team Spending Breakdown",
        "type": "piechart",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "tensorreaper_budget_spent_month",
            "legendFormat": "{{team}}"
          }
        ],
        "options": {
          "pieType": "donut",
          "displayLabels": ["name", "percent"],
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "title": "Budget vs Actual Spending",
        "type": "bargauge",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "tensorreaper_budget_spent_month",
            "legendFormat": "{{team}} - Spent"
          },
          {
            "expr": "tensorreaper_budget_monthly_limit",
            "legendFormat": "{{team}} - Budget"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "title": "Daily Spending Trend",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "rate(tensorreaper_budget_spent_month[24h]) * 86400",
            "legendFormat": "{{team}}"
          }
        ],
        "yaxes": [
          {"format": "currencyUSD", "label": "Daily Spend", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "stack": false,
        "linewidth": 2
      },
      {
        "title": "GPU Cost per Hour by Team",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
        "targets": [
          {
            "expr": "rate(tensorreaper_budget_spent_month[1h])",
            "legendFormat": "{{team}}"
          }
        ],
        "yaxes": [
          {"format": "currencyUSD", "label": "$/hour", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "stack": true
      },
      {
        "title": "Cost per GPU Hour by Type",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
        "targets": [
          {
            "expr": "tensorreaper_gpu_cost_per_hour",
            "format": "table",
            "instant": true
          },
          {
            "expr": "count(tensorreaper_gpu_count) by (gpu_type)",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "merge"
          },
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "gpu_type": "GPU Model",
                "Value #A": "Cost/Hour",
                "Value #B": "Total GPUs"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Cost/Hour"},
              "properties": [{"id": "unit", "value": "currencyUSD"}]
            }
          ]
        }
      },
      {
        "title": "Monthly Cost Projection",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
        "targets": [
          {
            "expr": "tensorreaper_budget_spent_month",
            "legendFormat": "{{team}} - Current Spend"
          },
          {
            "expr": "tensorreaper_budget_projected_spend",
            "legendFormat": "{{team}} - Projected"
          },
          {
            "expr": "tensorreaper_budget_monthly_limit",
            "legendFormat": "{{team}} - Budget Limit"
          }
        ],
        "yaxes": [
          {"format": "currencyUSD", "label": "USD", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 0,
        "linewidth": 2,
        "legend": {
          "show": true,
          "alignAsTable": true,
          "values": true,
          "current": true
        }
      },
      {
        "title": "GPU Hours Consumed by Team",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
        "targets": [
          {
            "expr": "tensorreaper_quota_gpu_hours",
            "legendFormat": "{{team}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "GPU Hours", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "stack": true
      },
      {
        "title": "Cost Efficiency - $/GPU Hour",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38},
        "targets": [
          {
            "expr": "tensorreaper_budget_spent_month / tensorreaper_quota_gpu_hours",
            "legendFormat": "{{team}}"
          }
        ],
        "yaxes": [
          {"format": "currencyUSD", "label": "Cost per GPU Hour", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 0,
        "linewidth": 2
      },
      {
        "title": "Savings vs Cloud (72% savings assumed)",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 38},
        "targets": [
          {
            "expr": "sum(tensorreaper_budget_spent_month) * (1 / 0.28 - 1)",
            "legendFormat": "Cloud Cost Avoided"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "color": {"mode": "fixed", "fixedColor": "green"}
          }
        }
      }
    ]
  }
}
