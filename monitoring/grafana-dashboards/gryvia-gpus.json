{
  "dashboard": {
    "title": "Gryvia - GPU Metrics",
    "tags": ["gryvia", "gpu", "nvidia"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "15s",
    "panels": [
      {
        "title": "GPU Health Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(gryvia_gpu_health_status == 1)",
            "legendFormat": "Healthy GPUs"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "title": "Average GPU Utilization",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "avg(gryvia_gpu_utilization_percent)",
            "legendFormat": "Avg Utilization"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 20, "color": "yellow"},
                {"value": 50, "color": "green"},
                {"value": 95, "color": "orange"}
              ]
            }
          }
        }
      },
      {
        "title": "Peak GPU Temperature",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "max(gryvia_gpu_temperature_celsius)",
            "legendFormat": "Max Temp"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 75, "color": "yellow"},
                {"value": 85, "color": "orange"},
                {"value": 90, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "title": "Total GPU Power Draw",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "sum(gryvia_gpu_power_watts)",
            "legendFormat": "Total Power"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "watt"
          }
        }
      },
      {
        "title": "GPU Utilization Heatmap",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "gryvia_gpu_utilization_percent",
            "legendFormat": "{{node}}-{{gpu_id}}",
            "format": "time_series"
          }
        ],
        "options": {
          "calculate": false,
          "yAxis": {
            "format": "short"
          },
          "color": {
            "mode": "spectrum",
            "scheme": "Spectral"
          }
        }
      },
      {
        "title": "GPU Utilization per Node",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "avg(gryvia_gpu_utilization_percent) by (node)",
            "legendFormat": "{{node}}"
          }
        ],
        "yaxes": [
          {"format": "percent", "min": 0, "max": 100, "label": "Utilization %"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 2,
        "linewidth": 2,
        "points": false,
        "pointradius": 2
      },
      {
        "title": "GPU Memory Usage per Node",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "avg(gryvia_gpu_memory_used_bytes) by (node) / 1024 / 1024 / 1024",
            "legendFormat": "{{node}}"
          }
        ],
        "yaxes": [
          {"format": "decgbytes", "min": 0, "label": "Memory Used"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 2,
        "stack": false
      },
      {
        "title": "Per-GPU Detailed Metrics",
        "type": "table",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "gryvia_gpu_utilization_percent",
            "format": "table",
            "instant": true
          },
          {
            "expr": "gryvia_gpu_temperature_celsius",
            "format": "table",
            "instant": true
          },
          {
            "expr": "gryvia_gpu_memory_used_bytes / 1024 / 1024 / 1024",
            "format": "table",
            "instant": true
          },
          {
            "expr": "gryvia_gpu_memory_total_bytes / 1024 / 1024 / 1024",
            "format": "table",
            "instant": true
          },
          {
            "expr": "gryvia_gpu_power_watts",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "merge"
          },
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "node": "Node",
                "gpu_id": "GPU ID",
                "gpu_type": "GPU Model",
                "Value #A": "Utilization (%)",
                "Value #B": "Temp (°C)",
                "Value #C": "Memory Used (GB)",
                "Value #D": "Memory Total (GB)",
                "Value #E": "Power (W)"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Utilization (%)"},
              "properties": [
                {"id": "custom.width", "value": 120},
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {"value": 0, "color": "red"},
                      {"value": 20, "color": "yellow"},
                      {"value": 50, "color": "green"}
                    ]
                  }
                },
                {"id": "custom.displayMode", "value": "color-background"}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "Temp (°C)"},
              "properties": [
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {"value": 0, "color": "green"},
                      {"value": 75, "color": "yellow"},
                      {"value": 85, "color": "red"}
                    ]
                  }
                },
                {"id": "custom.displayMode", "value": "color-background"}
              ]
            }
          ]
        }
      },
      {
        "title": "GPU Temperature Distribution",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
        "targets": [
          {
            "expr": "gryvia_gpu_temperature_celsius",
            "legendFormat": "{{node}}-GPU{{gpu_id}}"
          }
        ],
        "yaxes": [
          {"format": "celsius", "min": 0, "max": 100, "label": "Temperature"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 0,
        "linewidth": 1,
        "thresholds": [
          {
            "value": 85,
            "colorMode": "critical",
            "fill": false,
            "line": true,
            "op": "gt"
          }
        ]
      },
      {
        "title": "GPU Power Consumption",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
        "targets": [
          {
            "expr": "gryvia_gpu_power_watts",
            "legendFormat": "{{node}}-GPU{{gpu_id}}"
          },
          {
            "expr": "gryvia_gpu_power_limit_watts",
            "legendFormat": "{{node}}-GPU{{gpu_id}} Limit"
          }
        ],
        "yaxes": [
          {"format": "watt", "min": 0, "label": "Power"},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1
      }
    ]
  }
}
