{
  "dashboard": {
    "uid": "tensorreaper-ebpf-network",
    "title": "TensorReaper - eBPF Network Intelligence",
    "tags": ["tensorreaper", "ebpf", "network"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "DS_PROMETHEUS",
          "type": "datasource",
          "query": "prometheus"
        },
        {
          "name": "namespace",
          "type": "query",
          "datasource": "${DS_PROMETHEUS}",
          "query": "label_values(tensorreaper_network_flow_bytes_total, namespace)",
          "refresh": 2,
          "includeAll": true,
          "multi": true
        }
      ]
    },
    "panels": [
      {
        "title": "Network Flows per Second",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(rate(tensorreaper_network_flow_bytes_total{namespace=~\"$namespace\"}[5m])) by (src_service, dst_service)",
            "legendFormat": "{{src_service}} -> {{dst_service}}"
          }
        ],
        "yaxes": [
          {"format": "Bps", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "title": "Latency Heatmap",
        "type": "heatmap",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(increase(tensorreaper_network_latency_seconds_bucket{namespace=~\"$namespace\"}[1m])) by (le)",
            "legendFormat": "{{le}}",
            "format": "heatmap"
          }
        ],
        "options": {
          "calculate": false
        },
        "yAxis": {
          "format": "s"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges"
        }
      },
      {
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(tensorreaper_network_active_connections{namespace=~\"$namespace\"})",
            "legendFormat": "Active Connections"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1000, "color": "yellow"},
                {"value": 5000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "title": "Drops per Second",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(rate(tensorreaper_network_drops_total{namespace=~\"$namespace\"}[5m])) by (reason)",
            "legendFormat": "{{reason}}"
          }
        ],
        "yaxes": [
          {"format": "short", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "thresholds": [
          {"value": 100, "colorMode": "critical", "fill": false, "line": true, "op": "gt"}
        ]
      },
      {
        "title": "DNS Latency Histogram",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(tensorreaper_network_dns_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(tensorreaper_network_dns_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(tensorreaper_network_dns_latency_seconds_bucket{namespace=~\"$namespace\"}[5m])) by (le))",
            "legendFormat": "p99"
          }
        ],
        "yaxes": [
          {"format": "s", "min": 0},
          {"format": "short"}
        ],
        "lines": true,
        "fill": 0,
        "linewidth": 2
      },
      {
        "title": "Top Service Pairs by Traffic",
        "type": "table",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "topk(10, sum(rate(tensorreaper_network_flow_bytes_total{namespace=~\"$namespace\"}[5m])) by (src_service, dst_service))",
            "legendFormat": "{{src_service}} -> {{dst_service}}",
            "instant": true,
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "src_service": "Source",
                "dst_service": "Destination",
                "Value": "Bytes/s"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Bytes/s"},
              "properties": [
                {"id": "unit", "value": "Bps"}
              ]
            }
          ]
        }
      },
      {
        "title": "Network Anomalies Timeline",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(rate(tensorreaper_network_anomalies_total{namespace=~\"$namespace\"}[5m])) by (type)",
            "legendFormat": "{{type}}"
          }
        ],
        "yaxes": [
          {"format": "short", "min": 0},
          {"format": "short"}
        ],
        "lines": false,
        "bars": true,
        "fill": 1,
        "stack": true
      }
    ]
  }
}
